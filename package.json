{
	"name": "svelte-test",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"db:up": "podman-compose up -d",
		"db:down": "podman-compose down",
		"db:migrate": "bunx --bun prisma migrate dev",
		"db:seed": "bunx --bun prisma db seed",
		"db:studio": "bunx --bun prisma studio",
		"db:reset": "bunx --bun prisma migrate reset",
		"db:generate": "bunx --bun prisma generate"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/node": "^25.3.0",
		"svelte": "^5.51.0",
		"svelte-check": "^4.3.6",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vitest": "^4.0.18"
	},
	"dependencies": {
		"@node-rs/argon2": "^2.0.2",
		"@prisma/adapter-pg": "^7.4.1",
		"@prisma/client": "^7.4.1",
		"better-auth": "^1.4.19",
		"hangul-js": "^0.2.6",
		"prisma": "^7.4.1",
		"ts-fsrs": "^5.2.3"
	}
}
