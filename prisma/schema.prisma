generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ══════════════════════════════════════════════════════════════════════════════
// Auth domain (BetterAuth core schema)
// ══════════════════════════════════════════════════════════════════════════════

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt      @map("updated_at")

  sessions     Session[]
  accounts     Account[]
  reviewCards  ReviewCard[]
  reviewLogs   ReviewLog[]
  deckProgress UserDeckProgress[]
  streak       UserStreak?

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  idToken               String?   @map("id_token")
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt      @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt      @map("updated_at")

  @@map("verifications")
}

// ══════════════════════════════════════════════════════════════════════════════
// Grammar domain
// ══════════════════════════════════════════════════════════════════════════════

model GrammarPoint {
  id               String   @id @default(cuid())
  title            String
  category         String
  tense            String?
  register         String?
  hint             String
  description      String
  level            Int      @default(1)
  tags             String[]

  /// Grammar pattern formula shown in Structure card.
  /// e.g. "Noun + 은/는" or "Verb[stem] + 아/어요"
  structurePattern String?  @map("structure_pattern")

  /// JSON array of note sections displayed after the description.
  /// Shape: [{ type: 'caution' | 'funfact' | 'tip', title: string, content: string }]
  notes            Json?

  /// IDs of grammar points that are register/meaning variants of this one.
  /// e.g., -에요 (polite informal) links to -이다 (plain/copula).
  relatedPointIds  String[] @default([]) @map("related_point_ids")

  createdAt        DateTime @default(now()) @map("created_at")

  clozeCards       ClozeCard[]
  lessonExamples   LessonExample[]
  grammarTargets   ClozeCardGrammarTarget[]
  decks            DeckGrammarPoint[]
  reviewCards      ReviewCard[]

  @@map("grammar_points")
}

model ClozeCard {
  id                String   @id @default(cuid())
  grammarPointId    String   @map("grammar_point_id")
  fullSentence      String
  sentenceWithBlank String   @map("sentence_with_blank")
  vocabBaseForm     String   @map("vocab_base_form")
  answer            String
  alternateAnswers  String[] @map("alternate_answers")
  englishHint       Json
  createdAt         DateTime @default(now()) @map("created_at")

  /// Curriculum position of the "latest" grammar point in grammarTargets.
  /// Cached for efficient queue ordering — recomputed on seed/upsert.
  introducedAtPosition Int  @default(0) @map("introduced_at_position")

  grammarPoint   GrammarPoint             @relation(fields: [grammarPointId], references: [id], onDelete: Cascade)
  grammarTargets ClozeCardGrammarTarget[]
  lastShownIn    ReviewCard[]             @relation("LastClozeCard")

  @@map("cloze_cards")
}

/// Sentences shown during the learn phase while studying a grammar point.
/// Never surfaced in the FSRS review queue.
model LessonExample {
  id             String       @id @default(cuid())
  grammarPointId String       @map("grammar_point_id")
  grammarPoint   GrammarPoint @relation(fields: [grammarPointId], references: [id], onDelete: Cascade)
  fullSentence   String       @map("full_sentence")
  sentenceWithBlank String    @map("sentence_with_blank")
  answer         String
  englishHint    Json         @map("english_hint")
  order          Int          @default(0)
  notes          String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt      @map("updated_at")

  @@map("lesson_examples")
}

/// Join table: ClozeCard ↔ GrammarPoint (many-to-many with payload).
/// Each row declares which word/morpheme becomes blank when testing a specific GP.
model ClozeCardGrammarTarget {
  id              String       @id @default(cuid())
  clozeCardId     String       @map("cloze_card_id")
  clozeCard       ClozeCard    @relation(fields: [clozeCardId], references: [id], onDelete: Cascade)
  grammarPointId  String       @map("grammar_point_id")
  grammarPoint    GrammarPoint @relation(fields: [grammarPointId], references: [id], onDelete: Restrict)
  wordReplacement String       @map("word_replacement")
  blankIndex      Int          @default(0) @map("blank_index")
  createdAt       DateTime     @default(now()) @map("created_at")

  @@unique([clozeCardId, grammarPointId])
  @@map("cloze_card_grammar_targets")
}

// ══════════════════════════════════════════════════════════════════════════════
// FSRS domain (spaced repetition)
// ══════════════════════════════════════════════════════════════════════════════

/// One ReviewCard per (User, GrammarPoint) pair — tracks FSRS state.
/// The grammar point is the scheduling unit; the specific ClozeCard shown
/// during a review session is chosen dynamically at queue-build time.
model ReviewCard {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")

  /// The grammar point this FSRS record tracks.
  grammarPointId  String    @map("grammar_point_id")

  stability       Float     @default(0)
  difficulty      Float     @default(0)
  reps            Int       @default(0)
  lapses          Int       @default(0)
  state           Int       @default(0)
  due             DateTime  @default(now())
  lastReview      DateTime? @map("last_review")

  /// Mastery layer (non-breaking addition on top of FSRS)
  streakCorrect   Int       @default(0)    @map("streak_correct")
  masteredAt      DateTime? @map("mastered_at")

  /// Max stability ever achieved for this GP — for display-level mapping
  peakStability   Float     @default(0)    @map("peak_stability")

  /// Informational: which ClozeCard was shown in the most recent review session.
  /// Not used for scheduling — the next session re-selects dynamically.
  lastClozeCardId String?   @map("last_cloze_card_id")

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt      @map("updated_at")

  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  grammarPoint  GrammarPoint @relation(fields: [grammarPointId], references: [id], onDelete: Cascade)
  lastClozeCard ClozeCard? @relation("LastClozeCard", fields: [lastClozeCardId], references: [id], onDelete: SetNull)
  logs          ReviewLog[]

  @@unique([userId, grammarPointId])
  @@map("review_cards")
}

/// Individual review events — append-only log.
model ReviewLog {
  id            String   @id @default(cuid())
  reviewCardId  String   @map("review_card_id")
  userId        String   @map("user_id")
  rating        Int
  reviewedAt    DateTime @default(now()) @map("reviewed_at")

  stability     Float
  difficulty    Float
  elapsedDays   Float    @map("elapsed_days")
  scheduledDays Float    @map("scheduled_days")

  reviewCard ReviewCard @relation(fields: [reviewCardId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("review_logs")
}

// ══════════════════════════════════════════════════════════════════════════════
// Deck domain
// ══════════════════════════════════════════════════════════════════════════════

model Deck {
  id          String   @id @default(cuid())
  title       String   @unique
  slug        String   @unique
  description String
  level       Int      @default(1)
  topikLevel  String   @default("topik1-1") @map("topik_level")
  icon        String?
  isPublished Boolean  @default(true)  @map("is_published")
  sortOrder   Int      @default(0)     @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  grammarPoints DeckGrammarPoint[]
  userProgress  UserDeckProgress[]

  @@map("decks")
}

model DeckGrammarPoint {
  id             String @id @default(cuid())
  deckId         String @map("deck_id")
  grammarPointId String @map("grammar_point_id")
  sortOrder      Int    @map("sort_order")
  lessonNumber   Int    @map("lesson_number")

  deck         Deck         @relation(fields: [deckId], references: [id], onDelete: Cascade)
  grammarPoint GrammarPoint @relation(fields: [grammarPointId], references: [id], onDelete: Cascade)

  @@unique([deckId, grammarPointId])
  @@unique([deckId, sortOrder])
  @@map("deck_grammar_points")
}

model UserDeckProgress {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  deckId           String    @map("deck_id")
  enrolledAt       DateTime  @default(now()) @map("enrolled_at")
  lastStudiedAt    DateTime? @map("last_studied_at")
  lastLearnedIndex Int       @default(-1) @map("last_learned_index")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@unique([userId, deckId])
  @@map("user_deck_progress")
}

// ══════════════════════════════════════════════════════════════════════════════
// Streak domain
// ══════════════════════════════════════════════════════════════════════════════

model UserStreak {
  id              String    @id @default(cuid())
  userId          String    @unique @map("user_id")
  currentStreak   Int       @default(0) @map("current_streak")
  longestStreak   Int       @default(0) @map("longest_streak")
  lastStudiedDate DateTime? @map("last_studied_date")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt      @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_streaks")
}
